{
  "name": "cyber-battle-pro",
  "version": "1.9.0",
  "description": "Cyber Battle Pro: incident response command tool with a Field HQ team server and White Cell console",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "help": "node server.js --help",
    "white-cell": "node server.js --white-cell",
    "build": "npm run build:win && npm run build:linux",
    "build:win": "pkg . --targets node22-win-x64 --no-bytecode --public-packages \"*\" --public --compress Brotli --output dist/CBP-HQ.exe",
    "build:linux": "pkg . --targets node22-linux-x64 --no-bytecode --public-packages \"*\" --public --compress Brotli --output dist/CBP-HQ-linux"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "multicast-dns": "^7.2.5",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.0"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/pptxgenjs/dist/pptxgen.bundle.js",
      "node_modules/pdf-lib/dist/pdf-lib.min.js"
    ],
    "ignore": [
      "**/*.map",
      "**/*.d.ts",
      "**/*.md",
      "**/node_modules/pdf-lib/{cjs,es,src,ts3.4}/**",
      "**/node_modules/pdf-lib/dist/pdf-lib.{js,esm.js,esm.min.js}",
      "**/node_modules/@pdf-lib/**",
      "**/node_modules/pptxgenjs/{src,types}/**",
      "**/node_modules/pptxgenjs/dist/pptxgen.{cjs,es,min}.js",
      "**/node_modules/{jszip,image-size,@types,undici-types,pako,lie,immediate,setimmediate,queue,https}/**"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberLav/Cyber_Battle_Pro.git"
  },
  "homepage": "https://cyberlav.io",
  "author": "Alexander Lavrinenko"
}
